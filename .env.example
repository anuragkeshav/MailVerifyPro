# MailVerify Pro — Environment Configuration
# Copy this file to backend/.env and adjust as needed

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# SMTP Verification
SMTP_TIMEOUT=10000
HELO_DOMAIN=localhost
MAIL_FROM=verify@localhost

# Processing
CONCURRENCY=5
MAX_RETRIES=3

# Storage
DB_PATH=../data/verifier.db
EXPORTS_DIR=../exports
LOGS_DIR=../logs

# Logging
LOG_LEVEL=info
